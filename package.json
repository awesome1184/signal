{
  "name": "signal-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.client.config.ts --mode devvit",
    "build:server": "vite build --config vite.server.config.ts",
    "build:pages": "vite build --config vite.pages.config.ts --mode pages",
    "web:dev": "vite --config vite.pages.config.ts --mode pages --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "preflight": "npm run typecheck && npm run build",
    "upload": "npm run preflight && devvit upload",
    "playtest": "devvit playtest"
  },
  "dependencies": {
    "@devvit/web": "0.15.0",
    "@hono/node-server": "1.13.7",
    "hono": "4.7.2",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}