{
  "name": "signal-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "vite build",
    "build:pages": "vite build --config vite.pages.config.ts --mode pages",
    "web:dev": "vite --config vite.pages.config.ts --mode pages --base / --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "preflight": "npm run typecheck && npm run build",
    "upload": "npm run typecheck && devvit upload",
    "playtest": "devvit playtest"
  },
  "dependencies": {
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.7"
  }
}