{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "signal-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": { "inline": true, "entry": "splash.html" },
      "game": { "entry": "index.html" }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": { "enable": true }
  },
  "menu": {
    "items": [
      {
        "label": "Create a SIGNAL post",
        "description": "Launch the daily SIGNAL challenge",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-post"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}